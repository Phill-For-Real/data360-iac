                "sampleDetails": { "sortBy": [], "type": "TopN" }
              },
              "sources": []
            },
            "OUTPUT0": {
              "action": "outputD360",
              "parameters": {
                "fieldsMappings": [
                  { "sourceField": "vehicleId__c", "targetField": "vehicleId__c" },
                  { "sourceField": "lastServiceDate__c", "targetField": "lastServiceDate__c" },
                  { "sourceField": "isRecallOpen__c", "targetField": "isRecallOpen__c" }
                ],
                "name": "${DataLakeObject.vehicle_maintenance_enrichment_dlo.apiName}",
