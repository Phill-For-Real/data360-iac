        "name": "VehicleMaintenanceEnrichmentTransform",
        "label": "Vehicle Maintenance Enrichment",
        "type": "BATCH",
        "definition": {
          "type": "STL",
          "version": "63.0",
          "nodes": {
            "LOAD_DATASET0": {
              "action": "load",
              "parameters": {
                "dataset": { "name": "${DataStream.vehicle_stream.dlApiName}", "type": "dataLakeObject" },
